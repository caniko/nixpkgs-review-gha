{
  "$defs": {
    "Backend": {
      "enum": [
        "nixpkgs",
        "flake",
        "external-flake"
      ],
      "type": "string"
    },
    "BootstrapReceipt": {
      "additionalProperties": false,
      "properties": {
        "binary_sha256": {
          "type": "string"
        },
        "nar_hash": {
          "type": "string"
        },
        "nar_size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/NativeSource"
        }
      },
      "required": [
        "source",
        "nar_hash",
        "nar_size",
        "binary_sha256"
      ],
      "type": "object"
    },
    "CacheReceipt": {
      "additionalProperties": false,
      "properties": {
        "ready": {
          "$ref": "#/$defs/ReadyReceipt"
        },
        "sandbox_derivation": {
          "type": "string"
        },
        "sandbox_output": {
          "type": "string"
        },
        "sandbox_receipt_sha256": {
          "type": "string"
        }
      },
      "required": [
        "ready",
        "sandbox_derivation",
        "sandbox_output",
        "sandbox_receipt_sha256"
      ],
      "type": "object"
    },
    "CompilerCache": {
      "enum": [
        "kvrocks-v1"
      ],
      "type": "string"
    },
    "EffectivePlan": {
      "additionalProperties": false,
      "properties": {
        "compiler_cache": {
          "anyOf": [
            {
              "$ref": "#/$defs/CacheReceipt"
            },
            {
              "type": "null"
            }
          ]
        },
        "digest": {
          "type": "string"
        },
        "flake_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "lock": true,
        "lock_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata_digest": {
          "type": "string"
        },
        "source_nar_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "system": {
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/Target"
          },
          "type": "array"
        }
      },
      "required": [
        "metadata_digest",
        "system",
        "targets",
        "digest"
      ],
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "repository": {
          "type": "string"
        },
        "tree": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "repository",
        "commit",
        "tree"
      ],
      "type": "object"
    },
    "Mode": {
      "enum": [
        "head",
        "merge"
      ],
      "type": "string"
    },
    "Nar": {
      "additionalProperties": false,
      "properties": {
        "nar_hash": {
          "type": "string"
        },
        "nar_size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "nar_hash",
        "nar_size",
        "references"
      ],
      "type": "object"
    },
    "NativeSource": {
      "additionalProperties": false,
      "properties": {
        "derivation": {
          "type": "string"
        },
        "engine_repository": {
          "type": "string"
        },
        "engine_revision": {
          "type": "string"
        },
        "installable": {
          "type": "string"
        },
        "nixpkgs_revision": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "engine_repository",
        "engine_revision",
        "nixpkgs_revision",
        "system",
        "installable",
        "version",
        "derivation",
        "output"
      ],
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "unsupported",
        "not_run",
        "no_changes"
      ],
      "type": "string"
    },
    "Plan": {
      "additionalProperties": false,
      "properties": {
        "controller": {
          "$ref": "#/$defs/Identity"
        },
        "digest": {
          "type": "string"
        },
        "pr": {
          "anyOf": [
            {
              "$ref": "#/$defs/PullRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "$ref": "#/$defs/Request"
        },
        "request_id": {
          "type": "string"
        },
        "run_attempt": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_id": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_repository": {
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "target": {
          "$ref": "#/$defs/Identity"
        },
        "tool_lock": true,
        "tool_lock_digest": {
          "type": "string"
        },
        "workflow": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "request",
        "target",
        "controller",
        "workflow",
        "tool_lock",
        "tool_lock_digest",
        "run_repository",
        "run_id",
        "run_attempt",
        "digest"
      ],
      "type": "object"
    },
    "Publication": {
      "enum": [
        "none",
        "request-approval"
      ],
      "type": "string"
    },
    "PullRequest": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "head_repository": {
          "type": "string"
        },
        "merge": {
          "type": [
            "string",
            "null"
          ]
        },
        "number": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "parents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "url",
        "head_repository",
        "head",
        "base",
        "parents"
      ],
      "type": "object"
    },
    "ReadyReceipt": {
      "additionalProperties": false,
      "properties": {
        "invocation": {
          "$ref": "#/$defs/UnitIdentity"
        },
        "service": {
          "$ref": "#/$defs/ServicePlan"
        },
        "socket_device": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "socket_inode": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "supervisor": {
          "$ref": "#/$defs/UnitIdentity"
        }
      },
      "required": [
        "service",
        "invocation",
        "supervisor",
        "socket_device",
        "socket_inode"
      ],
      "type": "object"
    },
    "Recipe": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": "string"
        },
        "directory": {
          "default": ".",
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "source_input": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "commit",
        "source_input"
      ],
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "$ref": "#/$defs/Backend"
        },
        "cache_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "checks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "compiler_cache": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompilerCache"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit compiler-cache admission; absent legacy requests keep their digest."
        },
        "directory": {
          "default": ".",
          "type": "string"
        },
        "expected_base": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/$defs/Mode",
          "default": "head"
        },
        "nixpkgs_broken_warnings": {
          "description": "Package-scoped Nixpkgs broken warnings; omitted for legacy request identity.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "post_result": {
          "default": false,
          "type": "boolean"
        },
        "pr": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "publication": {
          "$ref": "#/$defs/Publication",
          "default": "none"
        },
        "recipe": {
          "anyOf": [
            {
              "$ref": "#/$defs/Recipe"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "runner_profile": {
          "default": "hosted-v1",
          "type": "string"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "skip_discovery": {
          "description": "Nixpkgs only: build exactly `packages` and `checks`, skipping changed-package\ndiscovery; omitted when false so legacy request identity is unchanged.",
          "type": "boolean"
        },
        "systems": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "test_profile": {
          "default": "checks-v1",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "repository",
        "backend",
        "systems"
      ],
      "type": "object"
    },
    "ServicePlan": {
      "additionalProperties": false,
      "properties": {
        "bootstrap": {
          "$ref": "#/$defs/BootstrapReceipt"
        },
        "config": {
          "type": "string"
        },
        "control_directory": {
          "type": "string"
        },
        "cpu_quota_percent": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "identity": {
          "$ref": "#/$defs/WorkerIdentity"
        },
        "lifetime_seconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "max_db_gib": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "memory_max_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_identity": {
          "type": "string"
        },
        "sandbox_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "shutdown_seconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "socket": {
          "type": "string"
        },
        "startup_seconds": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "state_directory": {
          "type": "string"
        },
        "systemd_args": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unit": {
          "type": "string"
        }
      },
      "required": [
        "bootstrap",
        "identity",
        "run_identity",
        "unit",
        "state_directory",
        "control_directory",
        "socket",
        "sandbox_paths",
        "startup_seconds",
        "shutdown_seconds",
        "lifetime_seconds",
        "memory_max_bytes",
        "cpu_quota_percent",
        "max_db_gib",
        "config",
        "systemd_args"
      ],
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "type": "boolean"
        },
        "derivation": {
          "type": "string"
        },
        "installable": {
          "type": "string"
        },
        "outputs": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "installable",
        "derivation",
        "outputs",
        "check"
      ],
      "type": "object"
    },
    "UnitIdentity": {
      "additionalProperties": false,
      "properties": {
        "control_group": {
          "type": "string"
        },
        "invocation_id": {
          "type": "string"
        },
        "pid": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "invocation_id",
        "pid",
        "control_group"
      ],
      "type": "object"
    },
    "WorkerIdentity": {
      "additionalProperties": false,
      "properties": {
        "gid": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "group": {
          "type": "string"
        },
        "uid": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "user": {
          "type": "string"
        }
      },
      "required": [
        "user",
        "uid",
        "group",
        "gid"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build": {
      "$ref": "#/$defs/Outcome"
    },
    "closure": {
      "additionalProperties": {
        "$ref": "#/$defs/Nar"
      },
      "type": "object"
    },
    "closure_export": {
      "$ref": "#/$defs/Outcome"
    },
    "compiler_cache_cleanup": {
      "anyOf": [
        {
          "$ref": "#/$defs/Outcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "effective": {
      "$ref": "#/$defs/EffectivePlan"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "nix_version": {
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/Plan"
    },
    "publication": {
      "$ref": "#/$defs/Outcome"
    },
    "retrieval": {
      "$ref": "#/$defs/Outcome"
    },
    "runner_architecture": {
      "type": "string"
    },
    "sandbox": {
      "type": "string"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "target_outcomes": {
      "additionalProperties": {
        "$ref": "#/$defs/Outcome"
      },
      "type": "object"
    },
    "test_evidence": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "tests": {
      "$ref": "#/$defs/Outcome"
    }
  },
  "required": [
    "schema_version",
    "plan",
    "effective",
    "runner_architecture",
    "nix_version",
    "sandbox",
    "build",
    "tests",
    "closure_export",
    "publication",
    "retrieval",
    "files",
    "target_outcomes",
    "test_evidence",
    "closure"
  ],
  "title": "PlatformResult",
  "type": "object"
}
